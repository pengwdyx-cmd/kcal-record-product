# ============================================================
# 环境变量模板｜复制到 .env.local 后填写真实值
#   cp .env.local.example .env.local
# .env.local 已被 .gitignore 排除，不会进入版本库，可安全放密钥。
#
# 当前阶段（前端 Demo）尚未接 Coze API，下列工作流变量仅为
# 后续对接预留，代码目前不读取它们；不要误以为填了就生效。
# ============================================================

# ---- 运行环境（代码已在 src/server.ts 读取）----
# 开发时留空即可；生产环境设为 PROD
COZE_PROJECT_ENV=

# 服务监听端口（默认 5000；本地验证曾用 5100）
PORT=5000

# ---- Coze 工作流对接项（src/app/api/coze/*/route.ts 服务端读取）----
# 工作流 1：图片识别，输出 meal_image + confirmation_dishes
COZE_WORKFLOW1_ID=
# 工作流 2：营养计算，输入 daily_target_kcal + confirmation_dishes
COZE_WORKFLOW2_ID=
# Coze API 鉴权（请在 Coze 平台生成后填入，切勿提交到仓库）
COZE_API_TOKEN=
# Coze 应用 ID（工作流调用时使用）
COZE_APP_ID=

# 若后续改用对象存储承载 meal_image，可在此配置（当前未使用）
# S3_BUCKET=
# S3_REGION=
